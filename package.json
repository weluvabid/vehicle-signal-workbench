{
  "name": "vehicle-signal-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "sh ./scripts/install-hooks.sh",
    "test": "tsx --test",
    "benchmark:measurements": "node --experimental-strip-types scripts/benchmark-measurements.mjs",
    "fixtures:generate": "node scripts/generate-measurement-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:performance": "VSW_RUN_PERFORMANCE=1 playwright test tests/e2e/performance.spec.ts",
    "test:e2e:performance:10m": "VSW_RUN_PERFORMANCE=1 VSW_RUN_10M=1 playwright test tests/e2e/performance.spec.ts",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:e2e:cross-browser": "VSW_CROSS_BROWSER=1 playwright test",
    "samples:generate": "node data/samples/generate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@icons-pack/react-simple-icons": "^13.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.19.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vercel": "^66.2.0"
  }
}
